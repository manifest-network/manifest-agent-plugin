{
  "name": "manifest-agent-plugin",
  "version": "0.5.0",
  "private": true,
  "description": "Shared runtime dependencies for the Manifest Agent Claude Code and Codex plugins",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:skills": "node ci/build-packages.cjs --write-skills",
    "build:codex": "node ci/build-packages.cjs",
    "test:packages": "node ci/build-packages.cjs --check",
    "setup:runtime": "node scripts/setup-runtime.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:docs": "node ci/docs-ci.cjs docs/testing.md",
    "test:policy-completeness": "node ci/policy-completeness.cjs"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "0.32.4",
    "@manifest-network/manifest-mcp-node": "0.22.0",
    "request-filtering-agent": "3.2.0"
  },
  "overrides": {
    "ipaddr.js": "2.4.0",
    "@cosmjs/stargate": "npm:@manifest-network/stargate@0.32.4-ll.3",
    "axios": "1.19.0",
    "protobufjs": "7.6.5"
  }
}
